{
  "name": "site-creator-vinext-starter",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/run-vinext-build.mjs",
    "build:vercel": "next build --webpack",
    "start:vercel": "next start",
    "start": "vinext start",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --incremental false && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .omo",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "onnxruntime-web": "1.24.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
